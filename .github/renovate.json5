{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Mend hosted app defaults new repos to "silent" (scan only, no PRs).
  mode: "full",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Amsterdam)",
    "helpers:pinGitHubActionDigests",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{newVersion}}",
  // 0 = no cap. With a cap of 5, a few long-lived PRs (DB majors, jotihunt)
  // took every slot and new updates sat "rate-limited" on the dashboard.
  // Automerge keeps the open count low anyway.
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  prHourlyLimit: 0,
  ignorePaths: [
    "bootstrap/argocd/applications/_template.yaml.tpl",
  ],
  kubernetes: {
    managerFilePatterns: [
      "/^apps/.+\\.ya?ml$/",
      "/^bootstrap/.+\\.ya?ml$/",
    ],
  },
  customManagers: [
    {
      description: "Version ARGs annotated with a `# renovate:` comment in image Dockerfiles",
      customType: "regex",
      managerFilePatterns: ["/^images/.+/Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+=(?<currentValue>\\S+)",
      ],
    },
  ],
  packageRules: [
    {
      description: "Group all linuxserver.io images",
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/**"],
      groupName: "linuxserver.io",
    },
    {
      description: "Group Grafana stack",
      matchDatasources: ["docker"],
      matchPackageNames: ["grafana/**"],
      groupName: "grafana stack",
    },
    {
      description: "Auto-merge everything below a major (images, npm, Dockerfile ARGs)",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      automerge: true,
      automergeType: "branch",
    },
    {
      description: "Pin digests for mutable tags so :latest is still tracked",
      matchDatasources: ["docker"],
      matchCurrentValue: "/^(latest|stable)$/",
      pinDigests: true,
    },
    {
      description: "Never auto-merge major bumps",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["major-update"],
    },
    {
      description: "t3code rollouts kill running agent turns; merge by hand when idle",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/silkepilon/t3code"],
      automerge: false,
    },
    {
      description: "Jotihunt: no automerge (a mongo/traccar rollout mid-game is an outage); merge by hand outside 17–18 Oct",
      matchFileNames: ["apps/jotihunt/**"],
      automerge: false,
    },
  ],
}
