{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  mode: 'full',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(Europe/Amsterdam)',
    'helpers:pinGitHubActionDigests',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  commitMessageTopic: '{{depName}}',
  commitMessageExtra: 'to {{newVersion}}',
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  prHourlyLimit: 0,
  ignorePaths: [
    'bootstrap/argocd/applications/_template.yaml.tpl',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/^apps/.+\\.ya?ml$/',
      '/^bootstrap/.+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      description: 'Version ARGs annotated with a `# renovate:` comment in image Dockerfiles',
      customType: 'regex',
      managerFilePatterns: [
        '/^images/.+/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+=(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Group all linuxserver.io images',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/**',
      ],
      groupName: 'linuxserver.io',
    },
    {
      description: 'Group Grafana stack',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'grafana/**',
      ],
      groupName: 'grafana stack',
    },
    {
      description: 'Auto-merge everything below a major (images, npm, Dockerfile ARGs)',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
    },
    {
      description: 'Pin digests for mutable tags so :latest is still tracked',
      matchDatasources: [
        'docker',
      ],
      matchCurrentValue: '/^(latest|stable)$/',
      pinDigests: true,
    },
    {
      description: 'Never auto-merge major bumps',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'major-update',
      ],
    },
    {
      description: 't3code rollouts kill running agent turns; merge by hand when idle',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/silkepilon/t3code',
      ],
      automerge: false,
    },
    {
      description: 'docs site rolls out :latest itself (apps/sites/docs/updater.yaml); a pinned digest would undo every rollout',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/silkepilon/docs',
      ],
      enabled: false,
    },
  ],
}
